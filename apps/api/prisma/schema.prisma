generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
  schemas    = ["auth", "tenancy", "users", "fleet", "trips", "assignment", "admin"]
}

enum CompanyStatus {
  pending
  active
  suspended
  rejected

  @@schema("tenancy")
}

enum DriverStatus {
  available
  on_trip
  off_shift
  inactive
  suspended
  documents_blocked

  @@schema("fleet")
}

enum TripStatus {
  pending_assignment
  assigned
  driver_en_route
  in_progress
  completed
  cancelled_by_passenger
  cancelled_by_driver
  no_driver
  no_show
  expired

  @@schema("trips")
}

enum AssignmentStatus {
  created
  notified
  accepted
  rejected
  timeout
  cancelled
  completed

  @@schema("assignment")
}

enum ServiceType {
  taxi
  motorcycle
  comfort
  delivery

  @@schema("trips")
}

enum PaymentMethod {
  cash
  nequi
  daviplata
  card

  @@schema("trips")
}

enum ConsentPurpose {
  location

  @@schema("auth")
}

enum PushTokenPlatform {
  android
  ios

  @@schema("auth")
}

enum CompanyDocumentType {
  chamber_of_commerce
  tax_registry
  transport_authorization
  liability_insurance

  @@schema("tenancy")
}

enum DocumentVerificationStatus {
  pending
  verified
  rejected

  @@schema("tenancy")
}

enum CompanyDecision {
  approved
  documents_requested
  rejected
  credentials_reissued

  @@schema("tenancy")
}

enum DriverDocumentType {
  license
  soat
  vehicle_inspection
  operation_card

  @@schema("fleet")
}

model Company {
  companyId        Int           @id @default(autoincrement()) @map("company_id")
  legalName        String        @map("legal_name")
  taxId            String        @unique @map("tax_id")
  type             String        @map("type")
  municipalityId   Int           @map("municipality_id")
  vehicleCount     Int?          @map("vehicle_count")
  contactEmail     String?       @map("contact_email")
  contactFirstName String?       @map("contact_first_name")
  contactLastName  String?       @map("contact_last_name")
  contactPhone     String?       @map("contact_phone")
  status           CompanyStatus @default(active) @map("status")
  membershipFee    Decimal?      @map("membership_fee") @db.Decimal(12, 2)
  registeredAt     DateTime      @default(now()) @map("registered_at")

  municipality     Municipality       @relation(fields: [municipalityId], references: [municipalityId])
  drivers          Driver[]
  vehicles         Vehicle[]
  assignments      Assignment[]
  staff            User[]
  fareConfigs      FareConfig[]
  systemParameters SystemParameter[]
  documents        CompanyDocument[]
  reviews          CompanyReview[]   @relation("CompanyReviewSubject")
  driverDocuments  DriverDocument[]

  @@index([municipalityId])
  @@index([status, registeredAt])
  @@map("company")
  @@schema("tenancy")
}

model Municipality {
  municipalityId  Int    @id @default(autoincrement()) @map("municipality_id")
  name            String @map("name")
  department      String @map("department")
  coveragePolygon Json   @map("coverage_polygon")
  status          String @default("active") @map("status")

  companies    Company[]
  tripRequests TripRequest[]

  @@map("municipality")
  @@schema("tenancy")
}

model User {
  userId         Int       @id @default(autoincrement()) @map("user_id")
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  email          String?   @unique @map("email")
  phone          String    @unique @map("phone")
  passwordHash   String?   @map("password_hash")
  role           String    @map("role")
  accountStatus  String    @default("active") @map("account_status")
  companyId      Int?      @map("company_id")
  failedAttempts Int       @default(0) @map("failed_attempts")
  blockedUntil   DateTime? @map("blocked_until")
  createdAt      DateTime  @default(now()) @map("created_at")

  company                  Company?          @relation(fields: [companyId], references: [companyId], onDelete: Restrict, onUpdate: Cascade)
  passenger                Passenger?
  driver                   Driver?
  refreshTokens            RefreshToken[]
  pushTokens               PushToken[]
  systemParameterUpdates   SystemParameter[]
  fareConfigVersions       FareConfig[]      @relation("FareConfigAuthor")
  consentRecords           ConsentRecord[]
  verifiedCompanyDocuments CompanyDocument[] @relation("CompanyDocumentVerifier")
  companyReviews           CompanyReview[]   @relation("CompanyReviewer")

  @@index([companyId, role])
  @@map("user")
  @@schema("auth")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false) @map("revoked")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, revoked])
  @@index([expiresAt])
  @@map("refresh_token")
  @@schema("auth")
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  phone     String   @map("phone")
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0) @map("attempts")
  consumed  Boolean  @default(false) @map("consumed")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@map("otp_code")
  @@schema("auth")
}

model ConsentRecord {
  consentRecordId Int            @id @default(autoincrement()) @map("consent_record_id")
  userId          Int            @map("user_id")
  purpose         ConsentPurpose @map("purpose")
  noticeVersion   String         @map("notice_version")
  grantedAt       DateTime       @default(now()) @map("granted_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, purpose, noticeVersion])
  @@map("consent_record")
  @@schema("auth")
}

model PushToken {
  pushTokenId Int               @id @default(autoincrement()) @map("push_token_id")
  userId      Int               @map("user_id")
  token       String            @unique @map("token")
  platform    PushTokenPlatform @map("platform")
  createdAt   DateTime          @default(now()) @map("created_at")
  lastSeenAt  DateTime          @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("push_token")
  @@schema("auth")
}

model Passenger {
  passengerId            Int           @id @map("passenger_id")
  preferredPaymentMethod PaymentMethod @default(cash) @map("preferred_payment_method")
  mainAddress            String?       @map("main_address")
  trustedContact         String?       @map("trusted_contact")

  user         User          @relation(fields: [passengerId], references: [userId], onDelete: Cascade)
  tripRequests TripRequest[]

  @@map("passenger")
  @@schema("users")
}

model Driver {
  driverId          Int          @id @map("driver_id")
  companyId         Int          @map("company_id")
  nationalId        String       @unique @map("national_id")
  pin               String       @map("pin")
  license           String?      @map("license")
  averageRating     Float?       @map("average_rating")
  status            DriverStatus @default(off_shift) @map("status")
  failedAttempts    Int          @default(0) @map("failed_attempts")
  blockedUntil      DateTime?    @map("blocked_until")
  currentLat        Float?       @map("current_lat")
  currentLng        Float?       @map("current_lng")
  locationUpdatedAt DateTime?    @map("location_updated_at")
  currentVehicleId  Int?         @map("current_vehicle_id")
  pinDeliveredAt    DateTime?    @map("pin_delivered_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  user           User             @relation(fields: [driverId], references: [userId], onDelete: Cascade)
  company        Company          @relation(fields: [companyId], references: [companyId])
  currentVehicle Vehicle?         @relation("DriverCurrentVehicle", fields: [currentVehicleId], references: [vehicleId])
  assignments    Assignment[]
  documents      DriverDocument[]

  @@index([companyId, status])
  @@map("driver")
  @@schema("fleet")
}

model Vehicle {
  vehicleId     Int     @id @default(autoincrement()) @map("vehicle_id")
  companyId     Int     @map("company_id")
  plate         String  @unique @map("plate")
  model         String? @map("model")
  year          Int?    @map("year")
  operationCard String? @map("operation_card")
  status        String  @default("active") @map("status")

  company     Company      @relation(fields: [companyId], references: [companyId])
  drivers     Driver[]     @relation("DriverCurrentVehicle")
  assignments Assignment[]

  @@index([companyId, status])
  @@map("vehicle")
  @@schema("fleet")
}

model TripRequest {
  tripRequestId     Int           @id @default(autoincrement()) @map("trip_request_id")
  passengerId       Int           @map("passenger_id")
  municipalityId    Int           @map("municipality_id")
  serviceType       ServiceType   @default(taxi) @map("service_type")
  paymentMethod     PaymentMethod @default(cash) @map("payment_method")
  pickupAddress     String        @map("pickup_address")
  dropoffAddress    String        @map("dropoff_address")
  pickupLat         Float         @map("pickup_lat")
  pickupLng         Float         @map("pickup_lng")
  dropoffLat        Float         @map("dropoff_lat")
  dropoffLng        Float         @map("dropoff_lng")
  requestedAt       DateTime      @default(now()) @map("requested_at")
  status            TripStatus    @default(pending_assignment) @map("status")
  assignedAt        DateTime?     @map("assigned_at")
  arrivedAt         DateTime?     @map("arrived_at")
  type              String        @default("immediate") @map("type")
  scheduledPickupAt DateTime?     @map("scheduled_pickup_at")
  finishedAt        DateTime?     @map("finished_at")
  distance          Float?        @map("distance")
  fare              Decimal       @map("fare") @db.Decimal(12, 2)
  commission        Decimal       @map("commission") @db.Decimal(12, 2)
  netEarnings       Decimal?      @map("net_earnings") @db.Decimal(12, 2)
  cashCollectedAt   DateTime?     @map("cash_collected_at")
  penaltyRecorded   Boolean       @default(false) @map("penalty_recorded")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  passenger    Passenger    @relation(fields: [passengerId], references: [passengerId])
  municipality Municipality @relation(fields: [municipalityId], references: [municipalityId])
  assignments  Assignment[]

  @@index([municipalityId, status, requestedAt])
  @@index([serviceType, status])
  @@map("trip_request")
  @@schema("trips")
}

model FareConfig {
  fareConfigId        Int         @id @default(autoincrement()) @map("fare_config_id")
  companyId           Int         @map("company_id")
  serviceType         ServiceType @default(taxi) @map("service_type")
  baseFare            Decimal     @map("base_fare") @db.Decimal(12, 2)
  nightSurchargePct   Decimal     @default(20) @map("night_surcharge_pct") @db.Decimal(5, 2)
  holidaySurchargePct Decimal     @default(15) @map("holiday_surcharge_pct") @db.Decimal(5, 2)
  commissionPct       Decimal     @default(8) @map("commission_pct") @db.Decimal(5, 2)
  validFrom           DateTime    @default(now()) @map("valid_from") @db.Date
  validTo             DateTime?   @map("valid_to") @db.Date
  createdAt           DateTime    @default(now()) @map("created_at")
  createdBy           Int?        @map("created_by")

  company       Company @relation(fields: [companyId], references: [companyId])
  createdByUser User?   @relation("FareConfigAuthor", fields: [createdBy], references: [userId], onDelete: SetNull, onUpdate: Cascade)

  @@index([companyId, serviceType])
  @@index([companyId, serviceType, validFrom])
  @@map("fare_config")
  @@schema("trips")
}

model Assignment {
  assignmentId       Int              @id @default(autoincrement()) @map("assignment_id")
  tripRequestId      Int              @map("trip_request_id")
  driverId           Int              @map("driver_id")
  vehicleId          Int              @map("vehicle_id")
  companyId          Int              @map("company_id")
  status             AssignmentStatus @default(created) @map("status")
  assignedBy         String           @default("system") @map("assigned_by")
  attemptOrder       Int              @default(1) @map("attempt_order")
  assignedAt         DateTime         @default(now()) @map("assigned_at")
  notifiedAt         DateTime?        @map("notified_at")
  respondedAt        DateTime?        @map("responded_at")
  expiresAt          DateTime?        @map("expires_at")
  cancellationReason String?          @map("cancellation_reason")

  tripRequest TripRequest @relation(fields: [tripRequestId], references: [tripRequestId])
  driver      Driver      @relation(fields: [driverId], references: [driverId])
  vehicle     Vehicle     @relation(fields: [vehicleId], references: [vehicleId])
  company     Company     @relation(fields: [companyId], references: [companyId])

  @@index([driverId, status, assignedAt])
  @@index([tripRequestId, status])
  @@index([companyId, status])
  @@map("assignment")
  @@schema("assignment")
}

model SystemParameter {
  id        Int      @id @default(autoincrement())
  key       String   @map("key")
  value     String   @map("value")
  companyId Int      @map("company_id")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy Int?     @map("updated_by")

  company       Company @relation(fields: [companyId], references: [companyId])
  updatedByUser User?   @relation(fields: [updatedBy], references: [userId])

  @@unique([key, companyId])
  @@map("system_parameter")
  @@schema("admin")
}

model CompanyDocument {
  companyDocumentId Int                        @id @default(autoincrement()) @map("company_document_id")
  companyId         Int                        @map("company_id")
  type              CompanyDocumentType        @map("type")
  storageKey        String                     @map("storage_key")
  fileName          String                     @map("file_name")
  contentType       String                     @map("content_type")
  sizeBytes         Int                        @map("size_bytes")
  verification      DocumentVerificationStatus @default(pending) @map("verification")
  reviewNote        String?                    @map("review_note")
  issuedAt          DateTime?                  @map("issued_at") @db.Date
  expiresAt         DateTime?                  @map("expires_at") @db.Date
  uploadedAt        DateTime                   @default(now()) @map("uploaded_at")
  verifiedBy        Int?                       @map("verified_by")
  verifiedAt        DateTime?                  @map("verified_at")

  company        Company @relation(fields: [companyId], references: [companyId], onDelete: Cascade, onUpdate: Cascade)
  verifiedByUser User?   @relation("CompanyDocumentVerifier", fields: [verifiedBy], references: [userId], onDelete: SetNull, onUpdate: Cascade)

  @@unique([companyId, type])
  @@index([companyId, verification])
  @@map("company_document")
  @@schema("tenancy")
}

model CompanyReview {
  companyReviewId               Int                   @id @default(autoincrement()) @map("company_review_id")
  companyId                     Int                   @map("company_id")
  decision                      CompanyDecision       @map("decision")
  note                          String?               @map("note")
  acknowledgedRoutingLimitation Boolean               @default(false) @map("acknowledged_routing_limitation")
  municipalityActiveCompanyId   Int?                  @map("municipality_active_company_id")
  municipalityActiveCompanyName String?               @map("municipality_active_company_name")
  requestedDocumentTypes        CompanyDocumentType[] @default([]) @map("requested_document_types")
  reviewedBy                    Int                   @map("reviewed_by")
  createdAt                     DateTime              @default(now()) @map("created_at")

  company        Company @relation("CompanyReviewSubject", fields: [companyId], references: [companyId], onDelete: Cascade, onUpdate: Cascade)
  reviewedByUser User    @relation("CompanyReviewer", fields: [reviewedBy], references: [userId], onDelete: Restrict, onUpdate: Cascade)

  @@index([companyId, createdAt])
  @@index([decision, createdAt])
  @@map("company_review")
  @@schema("tenancy")
}

model DriverDocument {
  driverDocumentId Int                @id @default(autoincrement()) @map("driver_document_id")
  driverId         Int                @map("driver_id")
  companyId        Int                @map("company_id")
  type             DriverDocumentType @map("type")
  storageKey       String             @map("storage_key")
  fileName         String             @map("file_name")
  contentType      String             @map("content_type")
  sizeBytes        Int                @map("size_bytes")
  issuedAt         DateTime?          @map("issued_at") @db.Date
  expiresAt        DateTime           @map("expires_at") @db.Date
  uploadedAt       DateTime           @default(now()) @map("uploaded_at")

  driver  Driver  @relation(fields: [driverId], references: [driverId], onDelete: Cascade, onUpdate: Cascade)
  company Company @relation(fields: [companyId], references: [companyId])

  @@unique([driverId, type])
  @@index([companyId, expiresAt])
  @@map("driver_document")
  @@schema("fleet")
}
