# =============================================================================
# VoyYa Backend (standalone) — plantilla de entorno. Copia a `.env` para local.
# NUNCA subas `.env` con valores reales. Todo lo de aquí son PLACEHOLDERS.
# =============================================================================

# --- App -------------------------------------------------------------------
NODE_ENV=production
# Railway inyecta PORT automáticamente; API_PORT es solo el fallback local.
API_PORT=3000
LOG_LEVEL=info

# --- Observabilidad (ADR-023) ------------------------------------------------
# Sin SENTRY_DSN, Sentry queda desactivado (solo un warn en el arranque, no aborta).
# SENTRY_DSN=https://xxxx@oyyyy.ingest.de.sentry.io/zzzz
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE se fija en Railway a ${{RAILWAY_GIT_COMMIT_SHA}}

# --- Base de datos: Neon (PostgreSQL 16 + PostGIS) -------------------------
# DATABASE_URL = endpoint POOLED (PgBouncer): host con "-pooler" + pgbouncer=true.
# DIRECT_URL   = endpoint UNPOOLED (lo usa `prisma migrate deploy`).
# Usa sslmode=require. Si Prisma se queja de `channel_binding`, quítalo del query string.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/voyya?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/voyya?sslmode=require"

# --- Tokens / secretos (mínimo 32 caracteres ALEATORIOS) -------------------
# Generar cada uno con: openssl rand -base64 48
JWT_SECRET="CAMBIAR-secreto-aleatorio-de-al-menos-32-caracteres"
QUOTE_TOKEN_SECRET="CAMBIAR-secreto-aleatorio-de-al-menos-32-caracteres"

# --- Seguridad HTTP --------------------------------------------------------
# Gate de cabeceras de desarrollo: DEBE ser false en producción (se ignora igual).
AUTH_DEV_HEADERS=false
# Allowlist CORS separada por comas (orígenes de la consola/PWA). Vacío = sin CORS.
CORS_ORIGINS=""

# --- SMS (Twilio) — REQUERIDO en producción para el OTP del pasajero -------
# Si faltan las 3, en producción el arranque FALLA (fail-fast); en dev usa el stub.
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="CAMBIAR-token-de-twilio"
TWILIO_FROM_NUMBER="+1XXXXXXXXXX"
