# =============================================================================
# VoyYa Backend — plantilla de entorno. Copia a `.env` para local.
# NUNCA subas `.env` con valores reales. Todo lo de aquí son PLACEHOLDERS.
#
# Fuente de verdad: apps/api/src/config/env.schema.ts (la API valida al arrancar).
# Despliegue: docs/VoyYa/16-deploy.md (Paso 2, puntos 2 y 4).
#
# Leyenda de cada variable para Railway:
#   [PROD]  obligatoria en producción: sin ella la API NO arranca.
#   [OPC]   opcional: si falta usa el default indicado.
#   [LOCAL] solo desarrollo/tests: no se define en Railway.
# =============================================================================

# --- App ---------------------------------------------------------------------
# [PROD] En Railway: production. En local: development.
NODE_ENV=development
# [OPC] Railway inyecta PORT; API_PORT es solo el fallback local. Default 3000.
API_PORT=3000
# [OPC] silent|fatal|error|warn|info|debug|trace. Default info.
LOG_LEVEL=info

# --- Observabilidad (ADR-023) ------------------------------------------------
# [OPC] Sin SENTRY_DSN, Sentry queda desactivado (warn al arrancar, no aborta).
# SENTRY_DSN=https://xxxx@oyyyy.ingest.de.sentry.io/zzzz
# SENTRY_ENVIRONMENT=production
# En Railway: SENTRY_RELEASE=${{RAILWAY_GIT_COMMIT_SHA}}
# SENTRY_RELEASE=

# --- Base de datos: PostgreSQL 16 + PostGIS (Railway) ------------------------
# [PROD] Rol app_voyya (NO el dueño: con el dueño la RLS queda inerte).
# En Railway usa el hostname INTERNO del servicio Postgres. DIRECT_URL ya no existe (ADR-006).
DATABASE_URL="postgresql://app_voyya:PASSWORD@localhost:5459/voyya"
# [OPC] Backoff de conexión al arrancar. Defaults 6 / 500.
# DB_CONNECT_MAX_ATTEMPTS=6
# DB_CONNECT_RETRY_BASE_MS=500

# --- Tokens / secretos (mínimo 32 caracteres ALEATORIOS) ---------------------
# [PROD] Generar cada uno con: openssl rand -base64 48
JWT_SECRET="CAMBIAR-secreto-aleatorio-de-al-menos-32-caracteres"
QUOTE_TOKEN_SECRET="CAMBIAR-secreto-aleatorio-de-al-menos-32-caracteres"
# [OPC] Defaults: quote 120 s · access 900 s · refresh 30 días · bcrypt 12.
# QUOTE_TOKEN_TTL_SECONDS=120
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_DAYS=30
# BCRYPT_ROUNDS=12

# --- OTP del pasajero y login --------------------------------------------------
# [OPC] Defaults: longitud 4 · 300 s · 5 intentos · reenvío 30 s · 5 por 3600 s.
# OTP_LENGTH=4
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=30
# OTP_RATE_LIMIT_MAX=5
# OTP_RATE_LIMIT_WINDOW_SECONDS=3600
# [OPC] Defaults: 5 intentos · bloqueo 15 min. El PIN del conductor tiene la longitud del contrato
# (DRIVER_PIN_LENGTH en @voyyaa/shared); ya no es una variable de entorno.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_BLOCK_MINUTES=15
# [OPC] Entero 1-168, default 72. Vigencia del PIN temporal del conductor (ADR-028): vencido, el conductor
# no puede entrar y la consola debe reenviarle uno nuevo.
# DRIVER_TEMPORARY_PIN_TTL_HOURS=72

# --- Seguridad HTTP ------------------------------------------------------------
# [PROD] Debe ser false en producción (allí se ignora igual).
AUTH_DEV_HEADERS=false
# [PROD] Orígenes https de la consola, separados por comas, sin ruta ni barra final.
# Vacío, con http://, * o con ruta, la API NO arranca en producción. En local puede ir vacío.
CORS_ORIGINS="http://localhost:5173"
# [OPC] Límite general por IP. Defaults 60 s / 100 peticiones.
# THROTTLE_TTL_SECONDS=60
# THROTTLE_LIMIT=100

# --- SMS: OTP del pasajero y PIN del conductor -------------------------------
# [PROD] twilio | noop. En producción debe ser twilio. Default noop: tener las
# credenciales en el .env NO activa el envío real si no eliges twilio aquí.
SMS_PROVIDER=noop
# [PROD] Obligatorias con SMS_PROVIDER=twilio.
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="CAMBIAR-token-de-twilio"
TWILIO_FROM_NUMBER="+570000000000"

# --- Correo: decisiones de afiliación (ADR-021) ------------------------------
# [PROD] sendgrid | noop. En producción debe ser sendgrid.
EMAIL_PROVIDER=noop
# [PROD] Obligatorias con EMAIL_PROVIDER=sendgrid. Remitente verificado con SPF/DKIM.
SENDGRID_API_KEY="SG.CAMBIAR"
EMAIL_FROM="no-responder@voyya.co"
# [OPC] Default VoyYa.
# EMAIL_FROM_NAME=VoyYa

# --- Push al conductor (ADR-022) ---------------------------------------------
# [PROD] expo | noop. En producción debe ser expo.
PUSH_PROVIDER=noop
# [PROD] Obligatoria con PUSH_PROVIDER=expo.
EXPO_ACCESS_TOKEN="CAMBIAR-token-de-expo"
# [OPC] Defaults: timeout 3000 ms · los tokens sin uso se purgan a los 60 días.
# PUSH_SEND_TIMEOUT_MS=3000
# PUSH_TOKEN_TTL_DAYS=60

# --- Afiliación de empresas y documentos (ADR-021) ---------------------------
# [PROD] URL pública de esta API: base de los enlaces de descarga de documentos.
API_PUBLIC_URL="http://localhost:3000"
# [PROD] Base del portal de afiliación (dominio de la consola en Vercel).
AFFILIATION_PORTAL_URL="http://localhost:5173"
# [PROD] openssl rand -base64 48. Rotarlo invalida los enlaces de carga ya enviados.
AFFILIATION_TOKEN_SECRET="CAMBIAR-secreto-aleatorio-de-al-menos-32-caracteres"
# [PROD] En Railway: /data/documents (dentro del volumen montado en /data).
DOCUMENT_STORAGE_ROOT="./.local-documents"
# [OPC] Defaults: 14 días · 5 MB · 600 s · 24 h · sin mínimo de espacio libre.
# AFFILIATION_TOKEN_TTL_DAYS=14
# DOCUMENT_MAX_BYTES=5242880
# DOCUMENT_SIGNED_URL_TTL_SEC=600
# DOCUMENT_STAGING_TTL_HOURS=24
# DOCUMENT_STORAGE_MIN_FREE_BYTES=

# --- Operación: asignación, viaje y ubicación --------------------------------
# [OPC] Defaults del motor de asignación y del viaje (ver glosario de parámetros).
# DEFAULT_MUNICIPALITY_ID=1
# SEARCH_RADIUS_KM=2
# EXPANSION_RADIUS_KM=6
# ACCEPTANCE_TIMEOUT_SEC=15
# MAX_AUTO_RETRIES=3
# TIEBREAK_WINDOW_HOURS=3
# CANCELLATION_WINDOW_MIN=2
# AVG_SPEED_KMH=20
# NO_SHOW_GRACE_MIN=5
# LOCATION_STALE_MIN=15
# [OPC] Default 12 h. Ley 1581: en producción debe estar entre 1 y 12 (el aviso al conductor promete borrar
# su ubicación a más tardar 13 h después del último reporte). 0 desactiva la purga y solo se admite fuera de
# producción.
# LOCATION_PURGE_HOURS=12
# [OPC] Entero >= 1, default 90. Días tras los que se eliminan coordenadas y direcciones de un viaje
# terminado (aviso de privacidad, ADR-029). En producción debe ser exactamente 90; cambiarlo exige cambiar
# la constante del contrato y subir LOCATION_NOTICE_VERSION.
# TRIP_COORDINATES_RETENTION_DAYS=90

# --- Solo operador / local (NO van en el servicio de Railway) ----------------
# [LOCAL] Rol dueño: solo para db:release y 01_provision_app_role.sql. Nunca variable de servicio.
# VOYYA_DB_OWNER_URL="postgresql://voyya_owner:PASSWORD@localhost:5459/voyya"
# [LOCAL] Solo al aprovisionar o rotar el rol app_voyya.
# APP_VOYYA_PASSWORD=
# [LOCAL] Solo db:seed local; el seed se niega contra cualquier base no local o no vacía.
# SEED_ADMIN_PASSWORD=
# [LOCAL] Tests e2e contra Postgres real.
# PG_TEST_URL="postgresql://app_voyya:PASSWORD@localhost:5459/voyya"
# PG_TEST_OWNER_URL="postgresql://voyya_owner:PASSWORD@localhost:5459/voyya"
